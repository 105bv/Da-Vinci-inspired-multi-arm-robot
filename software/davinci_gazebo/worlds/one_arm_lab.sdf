<?xml version="1.0"?>
<sdf version="1.9">
  <world name="davinci_lab">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.88 0.91 0.90 1</background></scene>
    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><plane><normal>0 0 1</normal><size>3 3</size></plane></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>3 3</size></plane></geometry>
          <material><ambient>0.65 0.72 0.65 1</ambient><diffuse>0.65 0.72 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Flat visual markers only: no objects, conveyor dynamics, or physical grasp. -->
    <model name="pickup_marker">
      <static>true</static><pose>0.30 -0.14 0.001 0 0 0</pose>
      <link name="marker">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material><ambient>0.85 0.25 0.15 1</ambient><diffuse>0.85 0.25 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="placement_marker">
      <static>true</static><pose>-0.06 -0.31 0.001 0 0 0</pose>
      <link name="marker">
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.002</size></box></geometry>
          <material><ambient>0.2 0.4 0.85 1</ambient><diffuse>0.2 0.4 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
